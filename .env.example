# FocusClass Environment Configuration

# Optional: Add your live Firebase credentials below.
# If these are not provided, FocusClass will automatically use the built-in Local Demo Reactive Engine
# which allows complete multi-tab real-time session testing without any external setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI Service Layer (Optional for Phase 6)
# If left blank, the built-in deterministic pedagogical rule engine will provide instant real-time insights.
VITE_AI_API_KEY=
